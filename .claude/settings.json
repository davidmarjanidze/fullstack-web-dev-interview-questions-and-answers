{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run prettier --silent > /dev/null",
            "timeout": 120,
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
